# Copy this file to .env beside docker-compose.yml and fill it in. .env is never committed.

# The assets folder the Voyage WZ Extractor made from your own game files (absolute, or relative to this folder).
VOYAGE_ASSETS=../voyage-assets

# The password of the admin page, and of the in-game admin account "admin", which the server makes on its first
# start. Without it the admin page stays off and no admin account is made. Make it long.
VOYAGE_ADMIN_PASSWORD=

# The admin page's port on this machine (inside the container it is always 8585).
VOYAGE_ADMIN_PORT=8585
